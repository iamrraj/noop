// Copy to CareSecrets.xcconfig (gitignored) and fill in your own values to enable the family
// "care" emails: a morning summary of the wearer's previous day plus alert emails.
//
// These values are compiled into the app's Info.plist, so anyone holding the built app can read
// them. Use a dedicated sending credential that can be revoked on its own (for example a Mailgun
// SMTP credential created only for this), never a personal mailbox password.
//
// The connection is implicit TLS, so the port must be the provider's TLS port (465 for Mailgun:
// smtp.mailgun.org, or smtp.eu.mailgun.org for an EU domain).
CARE_SMTP_HOST = smtp.mailgun.org
CARE_SMTP_PORT = 465
CARE_SMTP_USERNAME = postmaster@mg.example.com
CARE_SMTP_PASSWORD = your_smtp_password_here
CARE_EMAIL_FROM = noop@mg.example.com
CARE_EMAIL_TO = you@example.com
// How the wearer is named in the emails.
CARE_PERSON_NAME = Mum
